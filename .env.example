# Server Port & Environment
PORT=3000
NODE_ENV=development

# Set to "true" only in authorized internal network audits to permit TLS scanning of RFC 1918/private IPs.
ALLOW_PRIVATE_TLS_SCAN=false

# GEMINI_API_KEY: Optional AI Studio runtime secret if server-side Gemini features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
